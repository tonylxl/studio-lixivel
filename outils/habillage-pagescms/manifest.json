{
  "manifest_version": 3,
  "name": "Studio Lixivel · Pages CMS",
  "description": "Habille Pages CMS (app.pagescms.org) aux couleurs du site Studio Lixivel, le traduit en français, ajoute des aides pour remplir le site et la dictée vocale des fiches projets.",
  "version": "1.3.1",
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.pagescms.org/*"
      ],
      "css": [
        "habillage.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.pagescms.org/*"
      ],
      "js": [
        "traduction.js",
        "aides.js",
        "dictee.js"
      ],
      "run_at": "document_end"
    }
  ]
}
